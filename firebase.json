{
    "functions": {
        "source": "functions",
        "runtime": "python311"
    },
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/ask",
                "function": "ask"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}